{
  "name": "dsh-updater",
  "version": "1.4.2",
  "private": true,
  "description": "Checks npm for a newer @deepseek-ai/dsh, shows it under the composer, and offers a one-click update that installs the new release and restarts DSH.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "scripts/update-dsh.ps1",
    "scripts/launch-detached.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node tests/host.test.mjs && node tests/client.test.mjs",
    "dry-run": "node tests/dry-run.mjs",
    "compat-preview": "node tests/compat-preview.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "update",
    "npm",
    "self-update"
  ],
  "license": "MIT"
}
